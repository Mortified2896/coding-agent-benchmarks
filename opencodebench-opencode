# sed-escape helper for evaluation template substitution
sed_escape() {
  local val="$1"
  val="${val//\\/\\\\}"
  val="${val//&/\\&}"
  val="${val//|/\\|}"
  val="${val//$'\n'/\\n}"
  val="${val//$'\x01'/\\x01}"
  printf '%s' "$val"
}

# Stage 2 Card 5: evaluation sidecar. Writes a pre-filled Human Evaluation
# template to <task_dir>/evaluation.md after the run finishes. Skips when
# OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE=1. Does not overwrite an existing
# evaluation.md; appends a Re-run note section instead.
write_evaluation_template() {
  local task_dir="$1"

  if [[ "${OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE:-}" == "1" ]]; then
    return 0
  fi

  local metadata_path="$task_dir/metadata.json"
  if [[ ! -f "$metadata_path" ]]; then
    return 0
  fi

  local template_path=""
  if [[ -f "$script_dir/config/evaluation_template.md" ]]; then
    template_path="$script_dir/config/evaluation_template.md"
  elif [[ -f "$repo_root/config/evaluation_template.md" ]]; then
    template_path="$repo_root/config/evaluation_template.md"
  fi

  if [[ -z "$template_path" ]]; then
    return 0
  fi

  local evaluation_path="$task_dir/evaluation.md"

  local tid rpath mid ttype stime ftime dur ec fc la ld wtd dp
  tid=$(jq -r '.task_id // "unknown"' "$metadata_path") || tid="unknown"
  rpath=$(jq -r '.repo_path // "unknown"' "$metadata_path") || rpath="unknown"
  mid=$(jq -r '.model_id // "unknown"' "$metadata_path") || mid="unknown"
  ttype=$(jq -r '.opencodebench.task_type // .task_type // "unspecified"' "$metadata_path") || ttype="unspecified"
  stime=$(jq -r '.start_time // "unknown"' "$metadata_path") || stime="unknown"
  ftime=$(jq -r '.finish_time // "unknown"' "$metadata_path") || ftime="unknown"
  dur=$(jq -r '.duration_seconds // "unknown"' "$metadata_path") || dur="unknown"
  ec=$(jq -r '.exit_code // "unknown"' "$metadata_path") || ec="unknown"
  fc=$(jq -r '.files_changed // 0' "$metadata_path") || fc="0"
  la=$(jq -r '.lines_added // 0' "$metadata_path") || la="0"
  ld=$(jq -r '.lines_deleted // 0' "$metadata_path") || ld="0"
  wtd=$(jq -r '.working_tree_dirty_after // "null"' "$metadata_path") || wtd="null"
  dp=$(jq -r '.diff_produced // "false"' "$metadata_path") || dp="false"

  local evaluated_at
  evaluated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) || evaluated_at="unknown"

  if [[ -f "$evaluation_path" ]]; then
    if ! {
      printf '%s\n' ""
      printf '%s\n' "## Re-run note"
      printf '%s\n' ""
      printf '%s\n' "This evaluation.md was re-generated on a subsequent run."
      printf '%s\n' ""
      printf '%s\n' "- **Re-run task_id:** $tid"
      printf '%s\n' "- **Re-run model_id:** $mid"
      printf '%s\n' "- **Re-run start_time:** $stime"
      printf '%s\n' "- **Re-run finish_time:** $ftime"
      printf '%s\n' "- **Re-run duration:** ${dur}s"
      printf '%s\n' "- **Re-run exit_code:** $ec"
      printf '%s\n' "- **Re-run files_changed:** $fc"
      printf '%s\n' "- **Re-run lines_added:** $la"
      printf '%s\n' "- **Re-run lines_deleted:** $ld"
      printf '%s\n' "- **Working tree dirty after:** $wtd"
      printf '%s\n' "- **Diff produced:** $dp"
    } >> "$evaluation_path"; then
      printf '%s\n' "Warning: failed to append re-run note to '$evaluation_path'" >&2
    fi
  else
    local d=$'\x01'
    local tid_e rpath_e mid_e ttype_e stime_e ftime_e dur_e ec_e fc_e la_e ld_e wtd_e dp_e ea_e
    tid_e=$(sed_escape "$tid")
    rpath_e=$(sed_escape "$rpath")
    mid_e=$(sed_escape "$mid")
    ttype_e=$(sed_escape "$ttype")
    stime_e=$(sed_escape "$stime")
    ftime_e=$(sed_escape "$ftime")
    dur_e=$(sed_escape "$dur")
    ec_e=$(sed_escape "$ec")
    fc_e=$(sed_escape "$fc")
    la_e=$(sed_escape "$la")
    ld_e=$(sed_escape "$ld")
    wtd_e=$(sed_escape "$wtd")
    dp_e=$(sed_escape "$dp")
    ea_e=$(sed_escape "$evaluated_at")
    if ! sed -e "s${d}<!-- run_id -->${d}${tid_e}${d}g" \
             -e "s${d}<!-- repository -->${d}${rpath_e}${d}g" \
             -e "s${d}<!-- model -->${d}${mid_e}${d}g" \
             -e "s${d}<!-- task_type -->${d}${ttype_e}${d}g" \
             -e "s${d}<!-- start_time -->${d}${stime_e}${d}g" \
             -e "s${d}<!-- finish_time -->${d}${ftime_e}${d}g" \
             -e "s${d}<!-- duration -->${d}${dur_e}${d}g" \
             -e "s${d}<!-- exit_code -->${d}${ec_e}${d}g" \
             -e "s${d}<!-- files_changed -->${d}${fc_e}${d}g" \
             -e "s${d}<!-- lines_added -->${d}${la_e}${d}g" \
             -e "s${d}<!-- lines_deleted -->${d}${ld_e}${d}g" \
             -e "s${d}<!-- working_tree_dirty_after -->${d}${wtd_e}${d}g" \
             -e "s${d}<!-- diff_produced -->${d}${dp_e}${d}g" \
             -e "s${d}<!-- evaluated_at -->${d}${ea_e}${d}g" \
             "$template_path" > "$evaluation_path"; then
      printf '%s\n' "Warning: failed to write '$evaluation_path'" >&2
    fi
  fi
}

# Stage 2.5: write pointer-only hermes_trace.json sidecar.
# Reads metadata.json from the just-finished run and writes absolute pointers
# to the on-disk Hermes session state. No-op when
# OPENCODEBENCH_SKIP_HERMES_TRACE=1.
write_hermes_trace() {
  local task_dir="$1"
  if [[ "${OPENCODEBENCH_SKIP_HERMES_TRACE:-}" == "1" ]]; then
    return 0
  fi
  local metadata_path="$task_dir/metadata.json"
  if [[ ! -f "$metadata_path" ]]; then
    return 0
  fi

  local captured_at task_id hermes_session_id hermes_session_platform
  local hermes_home hermes_webui_state_dir hermes_kanban_board hermes_interactive
  local hermes_user_prompt_source worker_prompt_source

  captured_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  task_id=$(jq -r '.task_id // ""' "$metadata_path")
  hermes_session_id=$(jq -r '.hermes_session_id // ""' "$metadata_path")
  hermes_session_platform=$(jq -r '.hermes_session_platform // "unknown"' "$metadata_path")
  hermes_home=$(jq -r '.hermes_home // ""' "$metadata_path")
  hermes_webui_state_dir=$(jq -r '.hermes_webui_state_dir // ""' "$metadata_path")
  hermes_kanban_board=$(jq -r '.hermes_kanban_board // ""' "$metadata_path")
  hermes_interactive=$(jq -r '.hermes_interactive // null' "$metadata_path")
  hermes_user_prompt_source=$(jq -r '.hermes_user_prompt_source // "unavailable"' "$metadata_path")
  worker_prompt_source=$(jq -r '.worker_prompt_source // "unavailable"' "$metadata_path")

  local interface="unknown"
  if [[ -n "$hermes_session_platform" && "$hermes_session_platform" != "unknown" ]]; then
    interface="$hermes_session_platform"
  elif [[ -n "$hermes_session_id" ]]; then
    interface="webui"
  fi

  local session_json_path=""
  local run_journal_dir=""
  if [[ -n "$hermes_webui_state_dir" && -n "$hermes_session_id" ]]; then
    session_json_path="${hermes_webui_state_dir}/sessions/${hermes_session_id}.json"
    run_journal_dir="${hermes_webui_state_dir}/sessions/_run_journal/${hermes_session_id}"
  fi

  local intervention_mode="unknown"
  if [[ "$hermes_interactive" == "true" ]]; then
    intervention_mode="interactive"
  elif [[ "$hermes_interactive" == "false" ]]; then
    intervention_mode="background"
  fi

  local user_prompt_sidecar=""
  local user_prompt_status="unavailable"
  if [[ "$hermes_user_prompt_source" != "unavailable" ]]; then
    user_prompt_sidecar="hermes_user_prompt.md"
    user_prompt_status="captured"
  fi

  local worker_prompt_sidecar=""
  local worker_prompt_status="unavailable"
  if [[ "$worker_prompt_source" != "unavailable" ]]; then
    worker_prompt_sidecar="worker_prompt.md"
    worker_prompt_status="captured"
  fi

  jq -n \
    --arg schema_version "stage-2.5/v1" \
    --arg captured_at "$captured_at" \
    --arg task_id "$task_id" \
    --arg interface "$interface" \
    --arg hermes_home "$hermes_home" \
    --arg hermes_session_id "$hermes_session_id" \
    --arg hermes_session_json_path "$session_json_path" \
    --arg hermes_run_journal_dir "$run_journal_dir" \
    --arg hermes_kanban_board "$hermes_kanban_board" \
    --arg intervention_mode "$intervention_mode" \
    --arg user_prompt_sidecar "$user_prompt_sidecar" \
    --arg user_prompt_status "$user_prompt_status" \
    --arg worker_prompt_sidecar "$worker_prompt_sidecar" \
    --arg worker_prompt_status "$worker_prompt_status" \
    '{
      schema_version: $schema_version,
      captured_at: $captured_at,
      task_id: $task_id,
      interface: $interface,
      hermes_home: $hermes_home,
      hermes_session_id: $hermes_session_id,
      hermes_session_json_path: (if $hermes_session_json_path == "" then null else $hermes_session_json_path end),
      hermes_run_journal_dir: (if $hermes_run_journal_dir == "" then null else $hermes_run_journal_dir end),
      hermes_kanban_board: $hermes_kanban_board,
      intervention_mode: $intervention_mode,
      user_prompt_sidecar: (if $user_prompt_sidecar == "" then null else $user_prompt_sidecar end),
      user_prompt_status: $user_prompt_status,
      worker_prompt_sidecar: (if $worker_prompt_sidecar == "" then null else $worker_prompt_sidecar end),
      worker_prompt_status: $worker_prompt_status
    }' > "$task_dir/hermes_trace.json"
}

opencode_exit_code=0
finished=0
finish_capture() {
  if [[ "$finished" -eq 0 ]]; then
    finished=1
    "$script_dir/capture-task-finish.sh" "$task_dir" "$opencode_exit_code" >/dev/null || true
    write_evaluation_template "$task_dir"
    write_hermes_trace "$task_dir"
    printf '%s\n' "OpenCodeBench task log directory: $task_dir"
  fi
}
trap finish_capture EXIT

# Stage 1 Hermes-hostile-env workaround:
# In terminals where Hermes has inherited OPENCODE_SERVER_PASSWORD /
# OPENCODE_SERVER_USERNAME, plain `opencode run ...` fails with
# `Error: Session not found` because those vars make a fresh opencode
# invocation try to authenticate against a (non-existent) local server.
# Strip them for non-attach invocations. Preserve them for `attach` so
# users can still connect to a running opencode server with basic auth.
# Never echo the values.
opencode_subcommand=""
for arg in "$@"; do
  case "$arg" in
    --*=*|-*) continue ;;
  esac
  opencode_subcommand="$arg"
  break
done

if [[ "$opencode_subcommand" != "attach" ]]; then
  unset OPENCODE_SERVER_PASSWORD OPENCODE_SERVER_USERNAME
fi

# Rewrite --dir args to the resolved absolute path so that opencode's
# own runtime chdir (which is relative to the resolved repo_root, not
# the caller's original PWD) lands in the same place the wrapper
# already resolved. All other args are passed through unchanged.
opencode_args=()
prev_was_dir=0
for arg in "$@"; do
  if [[ "$prev_was_dir" -eq 1 ]]; then
    opencode_args+=("$resolved_target_dir")
    prev_was_dir=0
    continue
  fi
  case "$arg" in
    --dir) opencode_args+=("--dir"); prev_was_dir=1 ;;
    --dir=*) opencode_args+=("--dir=$resolved_target_dir") ;;
    *) opencode_args+=("$arg") ;;
  esac
done

set +e
cd "$repo_root"
"$opencode_bin" "${opencode_args[@]}"
opencode_exit_code=$?
set -e

exit "$opencode_exit_code"
