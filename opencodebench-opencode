#!/usr/bin/env bash
set -euo pipefail

# bash equivalent of zsh's "${0:A}" (absolute path, symlinks resolved) and
# "${0:A:h}" (absolute path of the script's directory).
_script_path="$(readlink -f -- "$0")"
script_dir="$(dirname -- "$_script_path")"
wrapper_path="$_script_path"

# Stage 2 Card 3: --help handler. Print usage and exit before any side
# effects (no Git detection, no capture, no opencode launch). This is
# intentionally a separate top-level flag, not opencode's --help, so
# callers can read the Stage 2 env-var docs without launching a real
# OpenCode session.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'USAGE'
opencodebench-opencode — Stage 1/2 tracked wrapper for the real OpenCode CLI

Usage:
  opencodebench-opencode [--dir <path>] [--help] [-m <model>]
                         [--model <model>] [opencode-args...]

Required:
  Run from inside an existing Git repository, OR pass --dir <path>
  pointing to one. Stage 1 tracks existing Git repositories only;
  it does not run `git init` or select a configured project.

Stage 2 env vars (all optional):
  OPENCODEBENCH_UPSTREAM_ORCHESTRATOR   none|hermes|unknown
                                        (default: none)
  OPENCODEBENCH_HARNESS_MODE            direct|delegated
                                        (default: derived from orchestrator)
  OPENCODEBENCH_TASK_SOURCE             manual|user|cli|hermes_orchestrator|...
                                        (default: derived)
  OPENCODEBENCH_AGENT_COMMAND_LABEL     free-form string (default: <harness>-<mode>)
  OPENCODEBENCH_TRACKING_HARNESS        free-form string
  OPENCODEBENCH_EXECUTION_AGENT         free-form string
  OPENCODEBENCH_ORCHESTRATION_MODE      free-form string
  OPENCODEBENCH_REPO_DETECTION_METHOD   free-form string
  OPENCODEBENCH_WORKING_DIRECTORY       absolute path
  OPENCODEBENCH_LOG_ROOT                absolute path; must be outside any
                                        Git repository or gitignored
  OPENCODEBENCH_OPENCODE_BIN            absolute path to a real opencode
                                        binary (default: $PATH lookup)
  OPENCODEBENCH_TASK_TYPE               implementation | debugging | review
                                        | docs | investigation | refactor
                                        | validation | architecture
                                        Missing: task_type="unspecified"
                                        Unknown: raw value recorded + warn
  OPENCODE_MODEL or MODEL               <provider>/<model> string;
                                        can be overridden by -m / --model.
                                        Precedence: argv > OPENCODE_MODEL
                                        > MODEL > "unknown".
  OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE
                                        set to 1 to skip the evaluation
                                        sidecar (see below).
                                        Default: unset (template is written)
  OPENCODEBENCH_SKIP_HERMES_TRACE       set to 1 to skip the hermes_trace.json
                                         sidecar (see Stage 2.5).
                                         Default: unset (trace is written)
  OPENCODEBENCH_SKIP_HERMES_ORCHESTRATOR
                                         set to 1 to skip the ten new
                                         hermes_orchestrator_* fields
                                         and the opencodebench.orchestrator.*
                                         dual mirror (see Stage 2.6).
                                         Default: unset (capture is on)
  OPENCODEBENCH_HERMES_USER_PROMPT_WINDOW_SECONDS
                                        Override the liveness window for
                                        pending_user_message (seconds).
                                        Default: 60
  OPENCODEBENCH_HERMES_USER_PROMPT_LIVENESS=off
                                        Disable the liveness check for
                                        pending_user_message.
                                        Default: unset (liveness on)
  OPENCODEBENCH_HERMES_USER_PROMPT_PATH
                                        Absolute path to a file containing
                                        the Hermes user prompt.
                                        Default: unset
  OPENCODEBENCH_HERMES_USER_PROMPT      Direct env-var source for the Hermes
                                         user prompt text.
                                         Default: unset
  OPENCODEBENCH_HERMES_REASONING_LEVEL  Explicit override for the Hermes
                                         orchestrator reasoning level. When
                                         set, the wrapper records the
                                         normalized value as reasoning_level,
                                         "env_override" as the source, and
                                         the raw state.db value (if read) in
                                         reasoning_level_raw. Acceptable
                                         values: none, minimal, low, medium,
                                         high, extra_high, max, unavailable.
                                         Default: unset (capture falls
                                         through the precedence chain)
  OPENCODEBENCH_SKIP_HERMES_REASONING   set to 1 to skip the state.db read
                                         and the WebUI session JSON fallback
                                         for the reasoning level. All three
                                         fields stay at defaults:
                                         "unavailable", "skipped", null.
                                         Default: unset (capture is on)

Evaluation sidecar (Card 5):
  After each run the wrapper reads config/evaluation_template.md (the
  single source of truth) and copies it to <task_dir>/evaluation.md,
  replacing placeholder markers with run-context fields from
  metadata.json (task_id, repo_path, model_id, task_type, timing,
  exit_code, diff summary). If evaluation.md already exists (re-run),
  a Re-run note section is appended instead. Set
  OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE=1 to skip the sidecar.

Stage 1 metadata fields (always captured):
  task_id, timestamp, timestamp_start, session_start_time, harness,
  harness_mode, task_source, agent_command_label, launcher_used,
  opencode_executable_path, tracking_harness, execution_agent,
  upstream_orchestrator, orchestration_mode, repo_detection_method,
  working_directory, downstream_agent, downstream_agent_mode,
  hermes_executable_path, hermes_version, hermes_profile,
  hermes_memory_mode, hermes_memory_enabled,
  hermes_user_profile_enabled, model_id, reasoning_level,
  repo_path, cwd, git_root, git_commit, git_branch, git_status,
  git_head_before, git_branch_before, opencodebench.*, plus the
  Stage 2 fields added in Cards 1-4:
    model_id, start_time, finish_time, duration_seconds, exit_code,
    opencodebench.timing.{start_unix_seconds, finish_unix_seconds,
    duration_seconds}, opencodebench.task_type,
    opencodebench.task_type_status, files_changed, lines_added,
    lines_deleted, working_tree_dirty_after, diff_produced,
    diff_is_git_repo, opencodebench.diff_summary.{files_changed,
    lines_added, lines_deleted, working_tree_dirty_after,
    diff_produced, is_git_repo}.

OpenCode passthrough:
  All arguments other than --dir, -m, --model, --help, -h are passed
  through to the real opencode binary unchanged. --dir is rewritten
  to its resolved absolute path so opencode's runtime chdir matches
  the wrapper's repo detection.

Hermes-hostile env workaround:
  OPENCODE_SERVER_PASSWORD and OPENCODE_SERVER_USERNAME are stripped
  from the child env unless the opencode subcommand is "attach"
  (which needs them to authenticate against a running opencode
  server). This is a workaround for terminals that inherit those
  vars and cause plain `opencode run` to fail with "Session not found".

See docs/task-capture-wrapper.md for the full Stage 1 design and
.hermes/plans/2026-06-09-stage-2-implementation-plan.md for the
Stage 2 schema additions.
USAGE
  exit 0
fi

# Stage 1 supports two repo-detection modes:
#   - cwd_git_root:  no --dir flag, detect from wrapper's PWD
#   - opencode_dir_git_root: --dir <path> flag, use the resolved
#     target directory as the repo detection base
# This lets Hermes (or any caller) launch the wrapper from one
# directory and target a different repo with --dir. --dir is passed
# through to the real opencode binary unchanged.
# Walk args properly: track whether the previous arg was --dir, and
# use the LAST --dir value (matches typical CLI semantics).
target_dir_arg=""
prev_was_dir=0
for arg in "$@"; do
  if [[ "$prev_was_dir" -eq 1 ]]; then
    target_dir_arg="$arg"
    prev_was_dir=0
    continue
  fi
  case "$arg" in
    --dir) prev_was_dir=1 ;;
    --dir=*) target_dir_arg="${arg#--dir=}" ;;
  esac
done

# Walk args for -m/--model worker model specification.
# Supports: -m <model>, --model <model>, --model=<model>
# Uses last-wins semantics matching the --dir walks.
opencode_arg_model=""
opencode_arg_model_count=0
opencode_arg_model_seen=0
prev_was_model=0
for arg in "$@"; do
  if [[ "$prev_was_model" -eq 1 ]]; then
    prev_was_model=0
    opencode_arg_model_seen=1
    if [[ -z "$arg" || "$arg" == -* ]]; then
      continue
    fi
    opencode_arg_model="$arg"
    # Pre-increment: see comment in the --model= arm above.
    (( ++opencode_arg_model_count ))
    continue
  fi
  case "$arg" in
    -m) prev_was_model=1 ;;
    --model) prev_was_model=1 ;;
    # Use ++var (pre-increment) instead of var++ (post-increment):
    # under `set -e`, (( var++ )) exits 1 when var is 0 because zsh
    # returns the OLD value as the expression's exit code. Pre-increment
    # returns the NEW value, so 0->1 returns 1 and set -e is happy.
    --model=*) opencode_arg_model="${arg#--model=}"; opencode_arg_model_seen=1; (( ++opencode_arg_model_count )) ;;
  esac
done

if [[ -n "$target_dir_arg" ]]; then
  if [[ "$target_dir_arg" == /* ]]; then
    resolved_target_dir="$target_dir_arg"
  else
    resolved_target_dir="$PWD/$target_dir_arg"
  fi
  # bash equivalent of zsh's "${var:A}" — canonical absolute path. Guarded
  # so a non-existent path still falls through to the [[ ! -d ]] check below
  # and produces the same user-facing error message as the zsh version.
  resolved_target_dir="$(readlink -f -- "$resolved_target_dir" 2>/dev/null || printf '%s' "$resolved_target_dir")"
  if [[ ! -d "$resolved_target_dir" ]]; then
    printf '%s\n' "Error: --dir target is not an existing directory: $target_dir_arg" >&2
    printf '%s\n' "Resolved path: $resolved_target_dir" >&2
    exit 1
  fi
  if ! git -C "$resolved_target_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    printf '%s\n' "Error: --dir target is not inside a Git repository: $resolved_target_dir" >&2
    printf '%s\n' "Stage 1 tracks existing Git repositories only; it will not run git init or select a configured project." >&2
    exit 1
  fi
  working_directory="$resolved_target_dir"
  repo_detection_method="opencode_dir_git_root"
else
  working_directory="$PWD"
  repo_detection_method="cwd_git_root"
  if ! git -C "$working_directory" rev-parse --show-toplevel >/dev/null 2>&1; then
    printf '%s\n' "Error: opencodebench-opencode must be run from inside an existing Git repository." >&2
    printf '%s\n' "Checked working directory: $working_directory" >&2
    printf '%s\n' "(Or pass --dir <path> to target an existing Git repository from outside one.)" >&2
    printf '%s\n' "Stage 1 tracks existing Git repositories only; it will not run git init or select a configured project." >&2
    exit 1
  fi
fi

repo_root="$(git -C "$working_directory" rev-parse --show-toplevel)"
upstream_orchestrator="${OPENCODEBENCH_UPSTREAM_ORCHESTRATOR:-none}"

# Resolve the worker model with precedence:
#   1. argv -m/--model value (opencode_arg_model)
#   2. OPENCODE_MODEL env
#   3. MODEL env
#   4. unknown (default)
resolved_model="unknown"
model_source="unknown"
if [[ "$opencode_arg_model_seen" -eq 1 ]]; then
  resolved_model="$opencode_arg_model"
  model_source="argv"
elif [[ -n "${OPENCODE_MODEL:-}" ]]; then
  resolved_model="$OPENCODE_MODEL"
  model_source="env"
elif [[ -n "${MODEL:-}" ]]; then
  resolved_model="$MODEL"
  model_source="env"
fi

# Provider split: part before the first /
provider="unknown"
if [[ -n "$resolved_model" && "$resolved_model" == */* ]]; then
  provider="${resolved_model%%/*}"
fi

case "$upstream_orchestrator" in
  ""|none)
    upstream_orchestrator="none"
    opencodebench_harness_mode="direct"
    opencodebench_task_source="user"
    opencodebench_orchestration_mode="none"
    ;;
  hermes)
    opencodebench_harness_mode="delegated"
    opencodebench_task_source="hermes_orchestrator"
    opencodebench_orchestration_mode="delegated_worker"
    ;;
  unknown)
    opencodebench_harness_mode="direct"
    opencodebench_task_source="user"
    opencodebench_orchestration_mode="unknown"
    ;;
  *)
    printf '%s\n' "Error: invalid OPENCODEBENCH_UPSTREAM_ORCHESTRATOR: $upstream_orchestrator" >&2
    printf '%s\n' "Allowed values: unset, none, hermes, unknown." >&2
    exit 1
    ;;
esac

opencode_bin="${OPENCODEBENCH_OPENCODE_BIN:-}"
if [[ -z "$opencode_bin" ]]; then
  if command -v opencode >/dev/null 2>&1; then
    opencode_bin="$(command -v opencode)"
  else
    printf '%s\n' "Error: opencode CLI not found in PATH." >&2
    exit 127
  fi
fi

# bash equivalent of zsh's "${var:A}" — canonical absolute path. Guarded
# so a missing/relative path still produces a useful error rather than
# crashing readlink. By this point command -v has succeeded (line above)
# so the path exists.
opencode_bin="$(readlink -f -- "$opencode_bin" 2>/dev/null || printf '%s' "$opencode_bin")"

if [[ ! -x "$opencode_bin" ]]; then
  printf '%s\n' "Error: resolved OpenCode binary is not executable: $opencode_bin" >&2
  exit 127
fi

case "$opencode_bin" in
  "$wrapper_path"|"$script_dir/opencodebench-opencode"|"$script_dir/opencode-bench.sh"|*"OpenCodeBench.app"*)
    printf '%s\n' "Error: resolved OpenCode binary points to an OpenCodeBench wrapper instead of the real OpenCode CLI: $opencode_bin" >&2
    exit 127
    ;;
esac

# Capture the OpenCode version for metadata.json, parallel to how
# hermes-bench.sh captures hermes_version. The flag is the same
# (`--version`) and the output is a single line on stdout on
# stock OpenCode 1.17.x. If the binary is unusual, we fall back
# to the literal string "unknown" so downstream consumers do not
# see null. Never raises — the binary has already passed
# existence + executability checks above, so a version failure
# is a soft signal, not a fatal one.
opencode_version="unknown"
if opencode_version_raw="$("$opencode_bin" --version 2>/dev/null | head -n 1)" \
   && [[ -n "$opencode_version_raw" ]]; then
  opencode_version="$opencode_version_raw"
fi

# Export resolved model/provider/source for downstream (capture-task-start.sh
# and the real opencode binary). When the resolved value is empty or is the
# literal string "unknown", export empty strings so the capture script's
# default fallback (${MODEL:-${OPENCODE_MODEL:-unknown}}) produces "unknown".
if [[ -z "$resolved_model" || "$resolved_model" == "unknown" ]]; then
  export OPENCODE_MODEL=""
  export MODEL=""
else
  export OPENCODE_MODEL="$resolved_model"
  export MODEL="$resolved_model"
fi
export OPENCODEBENCH_WORKER_MODEL="$resolved_model"
export OPENCODEBENCH_WORKER_PROVIDER="$provider"
export OPENCODEBENCH_WORKER_MODEL_SOURCE="$model_source"

# Stage 2.5: extract worker prompt (first positional arg after the subcommand)
worker_prompt=""
skip_next=0
found_subcmd=0
for arg in "$@"; do
  if [[ "$skip_next" -eq 1 ]]; then
    skip_next=0
    continue
  fi
  case "$arg" in
    --dir|-m|--model) skip_next=1 ;;
    --dir=*|--model=*) ;;
    --*) ;;
    -*) ;;
    *)
      if [[ "$found_subcmd" -eq 0 ]]; then
        found_subcmd=1
      else
        worker_prompt="$arg"
        break
      fi
      ;;
  esac
done
export OPENCODEBENCH_WORKER_PROMPT="$worker_prompt"

# Stage 2.7: normalize a reasoning-level string.
# Lowercase, replace spaces with underscores, trim leading/trailing whitespace.
# No semantic mapping. "low" stays "low". "Extra High" becomes "extra_high".
_horml_normalize() {
  local s="${1:-}"
  s="${s## }"  # leading trim
  s="${s%% }"  # trailing trim
  s="${s// /_}"  # spaces to underscores
  printf '%s' "$s" | tr '[:upper:]' '[:lower:]'
}

# Stage 2.6: resolve Hermes orchestrator metadata from the WebUI session JSON.
# Uses a single jq projection that picks only the 16 allow-listed top-level
# scalar fields. Populates shell variables that are passed through as
# HERMES_ORCHESTRATOR_* env vars to capture-task-start.sh.
resolve_hermes_orchestrator_metadata() {
  hermes_orchestrator_enabled="true"
  hermes_orchestrator_session_id=""
  hermes_orchestrator_model=""
  hermes_orchestrator_model_provider=""
  hermes_orchestrator_profile=""
  hermes_orchestrator_source_label="unavailable"
  hermes_orchestrator_is_cli_session="false"
  hermes_orchestrator_workspace=""
  hermes_orchestrator_worktree_path="null"
  hermes_orchestrator_reasoning_level="unavailable"
  # Stage 2.7: reasoning-level chain and its source/raw fields.
  hermes_orchestrator_reasoning_level_source="unavailable"
  hermes_orchestrator_reasoning_level_raw=""
  hermes_orchestrator_capture_source="none"

  if [[ "${OPENCODEBENCH_SKIP_HERMES_ORCHESTRATOR:-}" == "1" ]]; then
    hermes_orchestrator_capture_source="skipped"
    hermes_orchestrator_enabled="false"
    return 0
  fi

  # Stage 2.7: per-stage opt-out for the reasoning-level chain.
  if [[ "${OPENCODEBENCH_SKIP_HERMES_REASONING:-}" == "1" ]]; then
    hermes_orchestrator_reasoning_level="unavailable"
    hermes_orchestrator_reasoning_level_source="skipped"
    hermes_orchestrator_reasoning_level_raw=""
    return 0
  fi

  local session_json=""
  if [[ -n "${HERMES_WEBUI_STATE_DIR:-}" && -n "${HERMES_SESSION_ID:-}" ]]; then
    session_json="${HERMES_WEBUI_STATE_DIR}/sessions/${HERMES_SESSION_ID}.json"
  fi

  if [[ -z "$session_json" || ! -f "$session_json" || ! -r "$session_json" ]]; then
    local _has_hermes=0 _v
    for _v in HERMES_SESSION_ID HERMES_HOME HERMES_WEBUI_STATE_DIR \
              HERMES_KANBAN_BOARD HERMES_INTERACTIVE HERMES_PROFILE \
              HERMES_SESSION_PLATFORM HERMES_SESSION_CHAT_ID \
              HERMES_EXECUTABLE_PATH HERMES_VERSION \
              HERMES_MEMORY_MODE HERMES_MEMORY_ENABLED \
              HERMES_USER_PROFILE_ENABLED; do
      # bash equivalent of zsh's "${(P)_v:-}" — indirect expansion through
      # the variable whose name is the value of _v, treating unset as empty.
      if [[ -n "${!_v:-}" ]]; then _has_hermes=1; break; fi
    done
    if [[ "$_has_hermes" -eq 1 ]]; then
      hermes_orchestrator_capture_source="env"
    fi
    return 0
  fi

  # Stage 2.7: resolve reasoning level via a 4-step precedence chain.
  # The chain runs even if the WebUI session JSON is not present — the
  # env override and the state.db read are independent of the WebUI JSON.
  _horml_effort_raw=""
  _horml_state_db_readable=0
  if [[ -n "${HERMES_HOME:-}" && -n "${HERMES_SESSION_ID:-}" && -f "${HERMES_HOME}/state.db" ]]; then
    # Targeted, single-column, single-row read. NEVER select *; NEVER
    # read system_prompt; NEVER read state.db.messages. The grep-audit
    # in Card 3 will verify this is the only state.db read in the
    # wrapper.
    _horml_effort_raw=$(sqlite3 -separator $'\t' "${HERMES_HOME}/state.db" \
      "SELECT json_extract(model_config, '\$.reasoning_config.effort') \
       FROM sessions WHERE id = '${HERMES_SESSION_ID}' LIMIT 1;" 2>/dev/null || true)
    if [[ -n "$_horml_effort_raw" && "$_horml_effort_raw" != $'\t' ]]; then
      _horml_state_db_readable=1
    fi
  fi

  local projection
  projection=$(jq -c '{session_id, model, model_provider, profile, source_label,
    session_source, raw_source, is_cli_session, workspace,
    worktree_path, worktree_repo_root, worktree_branch, personality,
    context_engine, compression_anchor_mode}' "$session_json" 2>/dev/null) || {
    local _has_hermes=0 _v
    for _v in HERMES_SESSION_ID HERMES_HOME HERMES_WEBUI_STATE_DIR \
              HERMES_KANBAN_BOARD HERMES_INTERACTIVE HERMES_PROFILE \
              HERMES_SESSION_PLATFORM HERMES_SESSION_CHAT_ID \
              HERMES_EXECUTABLE_PATH HERMES_VERSION \
              HERMES_MEMORY_MODE HERMES_MEMORY_ENABLED \
              HERMES_USER_PROFILE_ENABLED; do
      # bash equivalent of zsh's "${(P)_v:-}" — indirect expansion through
      # the variable whose name is the value of _v, treating unset as empty.
      if [[ -n "${!_v:-}" ]]; then _has_hermes=1; break; fi
    done
    if [[ "$_has_hermes" -eq 1 ]]; then
      hermes_orchestrator_capture_source="env"
    fi
    return 0
  }

  hermes_orchestrator_session_id=$(jq -r '.session_id // ""' <<<"$projection")
  hermes_orchestrator_model=$(jq -r '.model // ""' <<<"$projection")
  hermes_orchestrator_model_provider=$(jq -r '.model_provider // ""' <<<"$projection")
  hermes_orchestrator_profile=$(jq -r '.profile // ""' <<<"$projection")

  local sl ss rs
  sl=$(jq -r '.source_label // ""' <<<"$projection")
  ss=$(jq -r '.session_source // ""' <<<"$projection")
  rs=$(jq -r '.raw_source // ""' <<<"$projection")
  if [[ -n "$sl" && "$sl" != "null" ]]; then
    hermes_orchestrator_source_label="$sl"
  elif [[ -n "$ss" && "$ss" != "null" ]]; then
    hermes_orchestrator_source_label="$ss"
  elif [[ -n "$rs" && "$rs" != "null" ]]; then
    hermes_orchestrator_source_label="$rs"
  fi

  hermes_orchestrator_is_cli_session=$(jq -r '.is_cli_session // false' <<<"$projection")
  hermes_orchestrator_workspace=$(jq -r '.workspace // ""' <<<"$projection")
  hermes_orchestrator_worktree_path=$(jq -r '.worktree_path // null' <<<"$projection")

  # Stage 2.7 precedence chain.
  if [[ -n "${OPENCODEBENCH_HERMES_REASONING_LEVEL:-}" ]]; then
    # env override wins. We still record the raw state.db value (if any)
    # so the consumer can detect "user claimed high but state.db says low".
    hermes_orchestrator_reasoning_level=$(_horml_normalize "$OPENCODEBENCH_HERMES_REASONING_LEVEL")
    hermes_orchestrator_reasoning_level_source="env_override"
    hermes_orchestrator_reasoning_level_raw="$_horml_effort_raw"
  elif [[ "$_horml_state_db_readable" == "1" ]]; then
    hermes_orchestrator_reasoning_level=$(_horml_normalize "$_horml_effort_raw")
    hermes_orchestrator_reasoning_level_source="state_db"
    hermes_orchestrator_reasoning_level_raw="$_horml_effort_raw"
  else
    # Fall through to the Stage 2.6 WebUI chain (already implemented
    # below). The `if/elif` near L476 sets hermes_orchestrator_reasoning_level
    # from .context_engine or .compression_anchor_mode. If neither
    # produces a value, the level stays "unavailable" — at the bottom of
    # this function we will set _source to "webui_session_json" if the
    # level was upgraded from "unavailable", or "unavailable" otherwise.
    : # (no-op; let the existing WebUI chain run)
  fi

  local ce cam
  ce=$(jq -r '.context_engine // ""' <<<"$projection")
  cam=$(jq -r '.compression_anchor_mode // ""' <<<"$projection")
  if [[ -n "$ce" && "$ce" != "null" ]]; then
    _horml_webui_raw="$ce"
    hermes_orchestrator_reasoning_level="$ce"
  elif [[ -n "$cam" && "$cam" != "null" ]]; then
    _horml_webui_raw="$cam"
    hermes_orchestrator_reasoning_level="$cam"
  fi

  local _has_hermes=0 _v
  for _v in HERMES_SESSION_ID HERMES_HOME HERMES_WEBUI_STATE_DIR \
            HERMES_KANBAN_BOARD HERMES_INTERACTIVE HERMES_PROFILE \
            HERMES_SESSION_PLATFORM HERMES_SESSION_CHAT_ID \
            HERMES_EXECUTABLE_PATH HERMES_VERSION \
            HERMES_MEMORY_MODE HERMES_MEMORY_ENABLED \
            HERMES_USER_PROFILE_ENABLED; do
    # bash equivalent of zsh's "${(P)_v:-}" — see comment in first match.
    if [[ -n "${!_v:-}" ]]; then _has_hermes=1; break; fi
  done
  if [[ "$_has_hermes" -eq 1 ]]; then
    hermes_orchestrator_capture_source="env"
  else
    hermes_orchestrator_capture_source="session_json"
  fi

  # Stage 2.7: post-process the WebUI-chain case to populate the
  # source/raw fields if the WebUI path was the one that produced a
  # value. If the env override or state.db read already populated
  # these, this block is a no-op.
  if [[ "$hermes_orchestrator_reasoning_level_source" == "unavailable" && "$hermes_orchestrator_reasoning_level" != "unavailable" ]]; then
    hermes_orchestrator_reasoning_level_source="webui_session_json"
    hermes_orchestrator_reasoning_level_raw="${_horml_webui_raw:-}"
    hermes_orchestrator_reasoning_level=$(_horml_normalize "$hermes_orchestrator_reasoning_level")
  fi
}
resolve_hermes_orchestrator_metadata

task_dir=$(
  HARNESS=opencode \
  HARNESS_MODE="$opencodebench_harness_mode" \
  TRACKING_HARNESS=opencodebench \
  EXECUTION_AGENT=opencode \
  UPSTREAM_ORCHESTRATOR="$upstream_orchestrator" \
