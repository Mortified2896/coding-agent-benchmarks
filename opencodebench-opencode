#!/bin/zsh
set -euo pipefail

script_dir="${0:A:h}"
wrapper_path="${0:A}"

# Stage 2 Card 3: --help handler. Print usage and exit before any side
# effects (no Git detection, no capture, no opencode launch). This is
# intentionally a separate top-level flag, not opencode's --help, so
# callers can read the Stage 2 env-var docs without launching a real
# OpenCode session.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'USAGE'
opencodebench-opencode — Stage 1/2 tracked wrapper for the real OpenCode CLI

Usage:
  opencodebench-opencode [--dir <path>] [--help] [-m <model>]
                         [--model <model>] [opencode-args...]

Required:
  Run from inside an existing Git repository, OR pass --dir <path>
  pointing to one. Stage 1 tracks existing Git repositories only;
  it does not run `git init` or select a configured project.

Stage 2 env vars (all optional):
  OPENCODEBENCH_UPSTREAM_ORCHESTRATOR   none|hermes|unknown
                                        (default: none)
  OPENCODEBENCH_HARNESS_MODE            direct|delegated
                                        (default: derived from orchestrator)
  OPENCODEBENCH_TASK_SOURCE             manual|user|cli|hermes_orchestrator|...
                                        (default: derived)
  OPENCODEBENCH_AGENT_COMMAND_LABEL     free-form string (default: <harness>-<mode>)
  OPENCODEBENCH_TRACKING_HARNESS        free-form string
  OPENCODEBENCH_EXECUTION_AGENT         free-form string
  OPENCODEBENCH_ORCHESTRATION_MODE      free-form string
  OPENCODEBENCH_REPO_DETECTION_METHOD   free-form string
  OPENCODEBENCH_WORKING_DIRECTORY       absolute path
  OPENCODEBENCH_LOG_ROOT                absolute path; must be outside any
                                        Git repository or gitignored
  OPENCODEBENCH_OPENCODE_BIN            absolute path to a real opencode
                                        binary (default: $PATH lookup)
  OPENCODEBENCH_TASK_TYPE               implementation | debugging | review
                                        | docs | investigation | refactor
                                        | validation | architecture
                                        Missing: task_type="unspecified"
                                        Unknown: raw value recorded + warn
  OPENCODE_MODEL or MODEL               <provider>/<model> string;
                                        can be overridden by -m / --model.
                                        Precedence: argv > OPENCODE_MODEL
                                        > MODEL > "unknown".
  OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE
                                        set to 1 to skip the evaluation
                                        sidecar (see below).
                                        Default: unset (template is written)

Evaluation sidecar (Card 5):
  After each run the wrapper reads config/evaluation_template.md (the
  single source of truth) and copies it to <task_dir>/evaluation.md,
  replacing placeholder markers with run-context fields from
  metadata.json (task_id, repo_path, model_id, task_type, timing,
  exit_code, diff summary). If evaluation.md already exists (re-run),
  a Re-run note section is appended instead. Set
  OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE=1 to skip the sidecar.

Stage 1 metadata fields (always captured):
  task_id, timestamp, timestamp_start, session_start_time, harness,
  harness_mode, task_source, agent_command_label, launcher_used,
  opencode_executable_path, tracking_harness, execution_agent,
  upstream_orchestrator, orchestration_mode, repo_detection_method,
  working_directory, downstream_agent, downstream_agent_mode,
  hermes_executable_path, hermes_version, hermes_profile,
  hermes_memory_mode, hermes_memory_enabled,
  hermes_user_profile_enabled, model_id, reasoning_level,
  repo_path, cwd, git_root, git_commit, git_branch, git_status,
  git_head_before, git_branch_before, opencodebench.*, plus the
  Stage 2 fields added in Cards 1-4:
    model_id, start_time, finish_time, duration_seconds, exit_code,
    opencodebench.timing.{start_unix_seconds, finish_unix_seconds,
    duration_seconds}, opencodebench.task_type,
    opencodebench.task_type_status, files_changed, lines_added,
    lines_deleted, working_tree_dirty_after, diff_produced,
    diff_is_git_repo, opencodebench.diff_summary.{files_changed,
    lines_added, lines_deleted, working_tree_dirty_after,
    diff_produced, is_git_repo}.

OpenCode passthrough:
  All arguments other than --dir, -m, --model, --help, -h are passed
  through to the real opencode binary unchanged. --dir is rewritten
  to its resolved absolute path so opencode's runtime chdir matches
  the wrapper's repo detection.

Hermes-hostile env workaround:
  OPENCODE_SERVER_PASSWORD and OPENCODE_SERVER_USERNAME are stripped
  from the child env unless the opencode subcommand is "attach"
  (which needs them to authenticate against a running opencode
  server). This is a workaround for terminals that inherit those
  vars and cause plain `opencode run` to fail with "Session not found".

See docs/task-capture-wrapper.md for the full Stage 1 design and
.hermes/plans/2026-06-09-stage-2-implementation-plan.md for the
Stage 2 schema additions.
USAGE
  exit 0
fi

# Stage 1 supports two repo-detection modes:
#   - cwd_git_root:  no --dir flag, detect from wrapper's PWD
#   - opencode_dir_git_root: --dir <path> flag, use the resolved
#     target directory as the repo detection base
# This lets Hermes (or any caller) launch the wrapper from one
# directory and target a different repo with --dir. --dir is passed
# through to the real opencode binary unchanged.
# Walk args properly: track whether the previous arg was --dir, and
# use the LAST --dir value (matches typical CLI semantics).
target_dir_arg=""
prev_was_dir=0
for arg in "$@"; do
  if [[ "$prev_was_dir" -eq 1 ]]; then
    target_dir_arg="$arg"
    prev_was_dir=0
    continue
  fi
  case "$arg" in
    --dir) prev_was_dir=1 ;;
    --dir=*) target_dir_arg="${arg#--dir=}" ;;
  esac
done

# Walk args for -m/--model worker model specification.
# Supports: -m <model>, --model <model>, --model=<model>
# Uses last-wins semantics matching the --dir walks.
opencode_arg_model=""
opencode_arg_model_count=0
opencode_arg_model_seen=0
prev_was_model=0
for arg in "$@"; do
  if [[ "$prev_was_model" -eq 1 ]]; then
    prev_was_model=0
    opencode_arg_model_seen=1
    if [[ -z "$arg" || "$arg" == -* ]]; then
      continue
    fi
    opencode_arg_model="$arg"
    # Pre-increment: see comment in the --model= arm above.
    (( ++opencode_arg_model_count ))
    continue
  fi
  case "$arg" in
    -m) prev_was_model=1 ;;
    --model) prev_was_model=1 ;;
    # Use ++var (pre-increment) instead of var++ (post-increment):
    # under `set -e`, (( var++ )) exits 1 when var is 0 because zsh
    # returns the OLD value as the expression's exit code. Pre-increment
    # returns the NEW value, so 0->1 returns 1 and set -e is happy.
    --model=*) opencode_arg_model="${arg#--model=}"; opencode_arg_model_seen=1; (( ++opencode_arg_model_count )) ;;
  esac
done

if [[ -n "$target_dir_arg" ]]; then
  if [[ "$target_dir_arg" == /* ]]; then
    resolved_target_dir="$target_dir_arg"
  else
    resolved_target_dir="$PWD/$target_dir_arg"
  fi
  resolved_target_dir="${resolved_target_dir:A}"
  if [[ ! -d "$resolved_target_dir" ]]; then
    print -u2 "Error: --dir target is not an existing directory: $target_dir_arg"
    print -u2 "Resolved path: $resolved_target_dir"
    exit 1
  fi
  if ! git -C "$resolved_target_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    print -u2 "Error: --dir target is not inside a Git repository: $resolved_target_dir"
    print -u2 "Stage 1 tracks existing Git repositories only; it will not run git init or select a configured project."
    exit 1
  fi
  working_directory="$resolved_target_dir"
  repo_detection_method="opencode_dir_git_root"
else
  working_directory="$PWD"
  repo_detection_method="cwd_git_root"
  if ! git -C "$working_directory" rev-parse --show-toplevel >/dev/null 2>&1; then
    print -u2 "Error: opencodebench-opencode must be run from inside an existing Git repository."
    print -u2 "Checked working directory: $working_directory"
    print -u2 "(Or pass --dir <path> to target an existing Git repository from outside one.)"
    print -u2 "Stage 1 tracks existing Git repositories only; it will not run git init or select a configured project."
    exit 1
  fi
fi

repo_root="$(git -C "$working_directory" rev-parse --show-toplevel)"
upstream_orchestrator="${OPENCODEBENCH_UPSTREAM_ORCHESTRATOR:-none}"

# Resolve the worker model with precedence:
#   1. argv -m/--model value (opencode_arg_model)
#   2. OPENCODE_MODEL env
#   3. MODEL env
#   4. unknown (default)
resolved_model="unknown"
model_source="unknown"
if [[ "$opencode_arg_model_seen" -eq 1 ]]; then
  resolved_model="$opencode_arg_model"
  model_source="argv"
elif [[ -n "${OPENCODE_MODEL:-}" ]]; then
  resolved_model="$OPENCODE_MODEL"
  model_source="env"
elif [[ -n "${MODEL:-}" ]]; then
  resolved_model="$MODEL"
  model_source="env"
fi

# Provider split: part before the first /
provider="unknown"
if [[ -n "$resolved_model" && "$resolved_model" == */* ]]; then
  provider="${resolved_model%%/*}"
fi

case "$upstream_orchestrator" in
  ""|none)
    upstream_orchestrator="none"
    opencodebench_harness_mode="direct"
    opencodebench_task_source="user"
    opencodebench_orchestration_mode="none"
    ;;
  hermes)
    opencodebench_harness_mode="delegated"
    opencodebench_task_source="hermes_orchestrator"
    opencodebench_orchestration_mode="delegated_worker"
    ;;
  unknown)
    opencodebench_harness_mode="direct"
    opencodebench_task_source="user"
    opencodebench_orchestration_mode="unknown"
    ;;
  *)
    print -u2 "Error: invalid OPENCODEBENCH_UPSTREAM_ORCHESTRATOR: $upstream_orchestrator"
    print -u2 "Allowed values: unset, none, hermes, unknown."
    exit 1
    ;;
esac

opencode_bin="${OPENCODEBENCH_OPENCODE_BIN:-}"
if [[ -z "$opencode_bin" ]]; then
  if command -v opencode >/dev/null 2>&1; then
    opencode_bin="$(command -v opencode)"
  else
    print -u2 "Error: opencode CLI not found in PATH."
    exit 127
  fi
fi

opencode_bin="${opencode_bin:A}"

if [[ ! -x "$opencode_bin" ]]; then
  print -u2 "Error: resolved OpenCode binary is not executable: $opencode_bin"
  exit 127
fi

case "$opencode_bin" in
  "$wrapper_path"|"$script_dir/opencodebench-opencode"|"$script_dir/opencode-bench.sh"|*"OpenCodeBench.app"*)
    print -u2 "Error: resolved OpenCode binary points to an OpenCodeBench wrapper instead of the real OpenCode CLI: $opencode_bin"
    exit 127
    ;;
esac

# Export resolved model/provider/source for downstream (capture-task-start.sh
# and the real opencode binary). When the resolved value is empty or is the
# literal string "unknown", export empty strings so the capture script's
# default fallback (${MODEL:-${OPENCODE_MODEL:-unknown}}) produces "unknown".
if [[ -z "$resolved_model" || "$resolved_model" == "unknown" ]]; then
  export OPENCODE_MODEL=""
  export MODEL=""
else
  export OPENCODE_MODEL="$resolved_model"
  export MODEL="$resolved_model"
fi
export OPENCODEBENCH_WORKER_MODEL="$resolved_model"
export OPENCODEBENCH_WORKER_PROVIDER="$provider"
export OPENCODEBENCH_WORKER_MODEL_SOURCE="$model_source"

task_dir=$(
  HARNESS=opencode \
  HARNESS_MODE="$opencodebench_harness_mode" \
  TRACKING_HARNESS=opencodebench \
  EXECUTION_AGENT=opencode \
  UPSTREAM_ORCHESTRATOR="$upstream_orchestrator" \
  TASK_SOURCE="$opencodebench_task_source" \
  ORCHESTRATION_MODE="$opencodebench_orchestration_mode" \
  AGENT_COMMAND_LABEL=opencodebench-opencode \
  REPO_DETECTION_METHOD="$repo_detection_method" \
  WORKING_DIRECTORY="$working_directory" \
  LAUNCHER_USED=OpenCodeBench \
  OPENCODE_EXECUTABLE_PATH="$opencode_bin" \
  MODEL="${OPENCODE_MODEL:-unknown}" \
  "$script_dir/capture-task-start.sh" "$repo_root"
)

metadata_path="$task_dir/metadata.json"
opencodebench_session_id="$(basename "$task_dir")"
opencodebench_project_id="$(jq -r '.opencodebench.project_id // (.repo_path | split("/")[-1]) // "unknown"' "$metadata_path")"
opencodebench_repo_root="$(jq -r '.opencodebench.repo_root // .repo_path // empty' "$metadata_path")"
opencodebench_task_dir="$(jq -r '.opencodebench.task_dir // empty' "$metadata_path")"
opencodebench_git_commit_before="$(jq -r '.opencodebench.git_commit_before // .git_head_before // .git_commit // empty' "$metadata_path")"

if [[ -z "$opencodebench_git_commit_before" ]]; then
  opencodebench_git_commit_before="$(git -C "$opencodebench_repo_root" rev-parse HEAD 2>/dev/null || true)"
fi

export OPENCODEBENCH_SESSION_ID="$opencodebench_session_id"
export OPENCODEBENCH_PROJECT_ID="$opencodebench_project_id"
export OPENCODEBENCH_REPO_ROOT="$opencodebench_repo_root"
export OPENCODEBENCH_TASK_DIR="$opencodebench_task_dir"
export OPENCODEBENCH_GIT_COMMIT_BEFORE="$opencodebench_git_commit_before"

otel_escape_value() {
  jq -rn --arg value "$1" '$value | @uri'
}

opencodebench_otel_attributes="$(
  printf 'opencodebench.session_id=%s,opencodebench.project_id=%s,opencodebench.repo_root=%s,opencodebench.task_dir=%s,opencodebench.git_commit_before=%s' \
    "$(otel_escape_value "$OPENCODEBENCH_SESSION_ID")" \
    "$(otel_escape_value "$OPENCODEBENCH_PROJECT_ID")" \
    "$(otel_escape_value "$OPENCODEBENCH_REPO_ROOT")" \
    "$(otel_escape_value "$OPENCODEBENCH_TASK_DIR")" \
    "$(otel_escape_value "$OPENCODEBENCH_GIT_COMMIT_BEFORE")"
)"

if [[ -n "${OTEL_RESOURCE_ATTRIBUTES:-}" ]]; then
  export OTEL_RESOURCE_ATTRIBUTES="${OTEL_RESOURCE_ATTRIBUTES},${opencodebench_otel_attributes}"
else
  export OTEL_RESOURCE_ATTRIBUTES="$opencodebench_otel_attributes"
fi

# sed-escape helper for evaluation template substitution
sed_escape() {
  local val="$1"
  val="${val//\\/\\\\}"
  val="${val//&/\\&}"
  val="${val//|/\\|}"
  val="${val//$'\n'/\\n}"
  val="${val//$'\x01'/\\x01}"
  printf '%s' "$val"
}

# Stage 2 Card 5: evaluation sidecar. Writes a pre-filled Human Evaluation
# template to <task_dir>/evaluation.md after the run finishes. Skips when
# OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE=1. Does not overwrite an existing
# evaluation.md; appends a Re-run note section instead.
write_evaluation_template() {
  local task_dir="$1"

  if [[ "${OPENCODEBENCH_SKIP_EVALUATION_TEMPLATE:-}" == "1" ]]; then
    return 0
  fi

  local metadata_path="$task_dir/metadata.json"
  if [[ ! -f "$metadata_path" ]]; then
    return 0
  fi

  local template_path=""
  if [[ -f "$script_dir/config/evaluation_template.md" ]]; then
    template_path="$script_dir/config/evaluation_template.md"
  elif [[ -f "$repo_root/config/evaluation_template.md" ]]; then
    template_path="$repo_root/config/evaluation_template.md"
  fi

  if [[ -z "$template_path" ]]; then
    return 0
  fi

  local evaluation_path="$task_dir/evaluation.md"

  local tid rpath mid ttype stime ftime dur ec fc la ld wtd dp
  tid=$(jq -r '.task_id // "unknown"' "$metadata_path") || tid="unknown"
  rpath=$(jq -r '.repo_path // "unknown"' "$metadata_path") || rpath="unknown"
  mid=$(jq -r '.model_id // "unknown"' "$metadata_path") || mid="unknown"
  ttype=$(jq -r '.opencodebench.task_type // .task_type // "unspecified"' "$metadata_path") || ttype="unspecified"
  stime=$(jq -r '.start_time // "unknown"' "$metadata_path") || stime="unknown"
  ftime=$(jq -r '.finish_time // "unknown"' "$metadata_path") || ftime="unknown"
  dur=$(jq -r '.duration_seconds // "unknown"' "$metadata_path") || dur="unknown"
  ec=$(jq -r '.exit_code // "unknown"' "$metadata_path") || ec="unknown"
  fc=$(jq -r '.files_changed // 0' "$metadata_path") || fc="0"
  la=$(jq -r '.lines_added // 0' "$metadata_path") || la="0"
  ld=$(jq -r '.lines_deleted // 0' "$metadata_path") || ld="0"
  wtd=$(jq -r '.working_tree_dirty_after // "null"' "$metadata_path") || wtd="null"
  dp=$(jq -r '.diff_produced // "false"' "$metadata_path") || dp="false"

  local evaluated_at
  evaluated_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) || evaluated_at="unknown"

  if [[ -f "$evaluation_path" ]]; then
    if ! {
      print -r -- ""
      print -r -- "## Re-run note"
      print -r -- ""
      print -r -- "This evaluation.md was re-generated on a subsequent run."
      print -r -- ""
      print -r -- "- **Re-run task_id:** $tid"
      print -r -- "- **Re-run model_id:** $mid"
      print -r -- "- **Re-run start_time:** $stime"
      print -r -- "- **Re-run finish_time:** $ftime"
      print -r -- "- **Re-run duration:** ${dur}s"
      print -r -- "- **Re-run exit_code:** $ec"
      print -r -- "- **Re-run files_changed:** $fc"
      print -r -- "- **Re-run lines_added:** $la"
      print -r -- "- **Re-run lines_deleted:** $ld"
      print -r -- "- **Working tree dirty after:** $wtd"
      print -r -- "- **Diff produced:** $dp"
    } >> "$evaluation_path"; then
      print -u2 "Warning: failed to append re-run note to '$evaluation_path'"
    fi
  else
    local d=$'\x01'
    local tid_e rpath_e mid_e ttype_e stime_e ftime_e dur_e ec_e fc_e la_e ld_e wtd_e dp_e ea_e
    tid_e=$(sed_escape "$tid")
    rpath_e=$(sed_escape "$rpath")
    mid_e=$(sed_escape "$mid")
    ttype_e=$(sed_escape "$ttype")
    stime_e=$(sed_escape "$stime")
    ftime_e=$(sed_escape "$ftime")
    dur_e=$(sed_escape "$dur")
    ec_e=$(sed_escape "$ec")
    fc_e=$(sed_escape "$fc")
    la_e=$(sed_escape "$la")
    ld_e=$(sed_escape "$ld")
    wtd_e=$(sed_escape "$wtd")
    dp_e=$(sed_escape "$dp")
    ea_e=$(sed_escape "$evaluated_at")
    if ! sed -e "s${d}<!-- run_id -->${d}${tid_e}${d}g" \
             -e "s${d}<!-- repository -->${d}${rpath_e}${d}g" \
             -e "s${d}<!-- model -->${d}${mid_e}${d}g" \
             -e "s${d}<!-- task_type -->${d}${ttype_e}${d}g" \
             -e "s${d}<!-- start_time -->${d}${stime_e}${d}g" \
             -e "s${d}<!-- finish_time -->${d}${ftime_e}${d}g" \
             -e "s${d}<!-- duration -->${d}${dur_e}${d}g" \
             -e "s${d}<!-- exit_code -->${d}${ec_e}${d}g" \
             -e "s${d}<!-- files_changed -->${d}${fc_e}${d}g" \
             -e "s${d}<!-- lines_added -->${d}${la_e}${d}g" \
             -e "s${d}<!-- lines_deleted -->${d}${ld_e}${d}g" \
             -e "s${d}<!-- working_tree_dirty_after -->${d}${wtd_e}${d}g" \
             -e "s${d}<!-- diff_produced -->${d}${dp_e}${d}g" \
             -e "s${d}<!-- evaluated_at -->${d}${ea_e}${d}g" \
             "$template_path" > "$evaluation_path"; then
      print -u2 "Warning: failed to write '$evaluation_path'"
    fi
  fi
}

opencode_exit_code=0
finished=0
finish_capture() {
  if [[ "$finished" -eq 0 ]]; then
    finished=1
    "$script_dir/capture-task-finish.sh" "$task_dir" "$opencode_exit_code" >/dev/null || true
    write_evaluation_template "$task_dir"
    print -r -- "OpenCodeBench task log directory: $task_dir"
  fi
}
trap finish_capture EXIT

# Stage 1 Hermes-hostile-env workaround:
# In terminals where Hermes has inherited OPENCODE_SERVER_PASSWORD /
# OPENCODE_SERVER_USERNAME, plain `opencode run ...` fails with
# `Error: Session not found` because those vars make a fresh opencode
# invocation try to authenticate against a (non-existent) local server.
# Strip them for non-attach invocations. Preserve them for `attach` so
# users can still connect to a running opencode server with basic auth.
# Never echo the values.
opencode_subcommand=""
for arg in "$@"; do
  case "$arg" in
    --*=*|-*) continue ;;
  esac
  opencode_subcommand="$arg"
  break
done

if [[ "$opencode_subcommand" != "attach" ]]; then
  unset OPENCODE_SERVER_PASSWORD OPENCODE_SERVER_USERNAME
fi

# Rewrite --dir args to the resolved absolute path so that opencode's
# own runtime chdir (which is relative to the resolved repo_root, not
# the caller's original PWD) lands in the same place the wrapper
# already resolved. All other args are passed through unchanged.
opencode_args=()
prev_was_dir=0
for arg in "$@"; do
  if [[ "$prev_was_dir" -eq 1 ]]; then
    opencode_args+=("$resolved_target_dir")
    prev_was_dir=0
    continue
  fi
  case "$arg" in
    --dir) opencode_args+=("--dir"); prev_was_dir=1 ;;
    --dir=*) opencode_args+=("--dir=$resolved_target_dir") ;;
    *) opencode_args+=("$arg") ;;
  esac
done

set +e
cd "$repo_root"
"$opencode_bin" "${opencode_args[@]}"
opencode_exit_code=$?
set -e

exit "$opencode_exit_code"
