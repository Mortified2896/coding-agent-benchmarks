# Stage 1 env-var reference.
#
# The Stage 1 wrapper is opencodebench-opencode. It consumes a small
# number of env vars; everything else in earlier revisions of this
# file is intentionally not supported in Stage 1.

# How the wrapper was launched. Recorded as upstream_orchestrator in
# metadata.json. Allowed values: unset, none, hermes, unknown.
# Default: none.
#
# For Hermes-driven calls, set this to "hermes" in the parent shell:
#   OPENCODEBENCH_UPSTREAM_ORCHESTRATOR=hermes \
#     /path/to/opencodebench-opencode run --dir /path/to/target-repo ...
OPENCODEBENCH_UPSTREAM_ORCHESTRATOR=

# Optional explicit path to the real opencode binary. If unset, the
# wrapper uses `command -v opencode` and resolves it to an absolute
# path. The wrapper rejects any value that resolves to itself or to
# another OpenCodeBench wrapper.
OPENCODEBENCH_OPENCODE_BIN=

# Optional model label recorded in metadata.json. Has no effect on
# which model OpenCode actually uses; pass `-m` to the real opencode
# invocation as usual.
OPENCODE_MODEL=

# Optional log-root override. By default logs are written under the
# detected OpenCodeBench project checkout's local ignored log
# directory:
#   <OpenCodeBench root>/.local/coding-agent-task-logs/
#
# If no project checkout is detected, for example from an
# installed/copied script location, logs fall back to:
#   ${XDG_STATE_HOME:-$HOME/.local/state}/opencodebench/coding-agent-task-logs/
#
# If OPENCODEBENCH_LOG_ROOT points inside a Git repository, the log
# path must be gitignored. The wrapper refuses unsafe non-gitignored
# Git log roots because logs may contain prompts, diffs, metadata,
# local paths, and filenames.
OPENCODEBENCH_LOG_ROOT=

# The wrapper also reads the OpenCode env vars for backward
# compatibility with future OpenCode client versions:
#   - OPENCODE_SERVER_PASSWORD / OPENCODE_SERVER_USERNAME
#     These are unset in the child environment for local non-attach
#     runs (to avoid "Error: Session not found" when the parent
#     shell has inherited them) and preserved for `opencode attach`.
#     The wrapper never echoes or writes their values.
