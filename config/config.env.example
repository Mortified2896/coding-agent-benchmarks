# Copy this file to ~/.config/opencodebench/config.env and adjust as needed.

# Used by the macOS app launcher when OPENCODEBENCH_REPO is not set.
OPENCODEBENCH_DEFAULT_REPO="/Users/Jo/GitHub/HomeLab"

# Optional log-root override. By default logs are written under the detected
# OpenCodeBench project checkout's local ignored log directory:
# <OpenCodeBench root>/.local/coding-agent-task-logs/
#
# If no project checkout is detected, for example from an installed/copied
# script location, logs fall back to:
# ${XDG_STATE_HOME:-$HOME/.local/state}/opencodebench/coding-agent-task-logs/
#
# If this points inside a Git repository, the log path must be gitignored.
# OpenCodeBench refuses unsafe non-ignored Git log roots because logs may
# contain prompts, diffs, metadata, local paths, and filenames.
# OPENCODEBENCH_LOG_ROOT="/path/to/log/root"

# Optional real OpenCode CLI override. By default the wrapper uses:
# command -v opencode
# OPENCODE_BIN="/opt/homebrew/bin/opencode"
